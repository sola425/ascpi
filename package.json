    "build:apk": "python3 scripts/build_apk.py",
    "test:android-bridge": "node tests/android-bridge.cjs",
    "check:content": "python3 scripts/assemble_sources.py && python3 scripts/assemble_teaching.py",
    "test:teaching-ui": "node tests/teaching-browser.cjs",
    "test:offline": "node tests/offline-v4.cjs",
    "test:ux": "node tests/ux-audit-v4.cjs",
    "test:apk-assets": "node tests/apk-assets.cjs",
    "test:game": "node tests/game-browser.cjs",
    "test:arcade": "node tests/arcade-browser.cjs",
    "test:account": "node tests/account-duel-browser.cjs",
    "test:callback": "node tests/auth-callback.cjs",
    "test:db": "node supabase/tests/run-postgres.mjs",
    "test:voice": "node --test tests/voice.test.js",
    "test:game-ux": "node tests/ux-game-v5.cjs",
    "test:compatibility": "node tests/compatibility-browser.cjs"
